# Mac mini self-hosted mode
# Copy to .env on the Mac mini and fill in the local Postgres password.

# Local Postgres only. Do not use Railway in Mac mini server mode.
DATABASE_URL=postgresql://altcoin:CHANGE_ME@localhost:5432/altcoin_trading

# API/dashboard
API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_URL=
DEPLOYMENT_MODE=macmini
DATA_DIR=data
NGROK_ENABLED=false

# Paper only
LIVE_TRADING=false
RUN_TRADING_SCHEDULER=true
BINANCE_TESTNET=true
BINANCE_MARKET_DATA_TESTNET=false
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ₩1,000,000 at 1,400 KRW/USDT ≈ 714.285714 USDT.
PAPER_STARTING_CAPITAL=714.285714
ENTRY_DECISION_ENGINE=evaluation
MIN_CONFIDENCE=0.70
COOLDOWN_HOURS_PER_SYMBOL=48
FEE_MODE=taker

# Conservative strategy defaults
SETUP_MEANREV_ENABLED=true
SETUP_BREAKOUT_ENABLED=false
SETUP_TSMOM_ENABLED=false
SETUP_FUNDING_ENABLED=true
SETUP_VOLUME_ENABLED=false
ALLOW_LONG=false
ALLOW_SHORT=true

# Risk management
MAX_OPEN_POSITIONS=5
MAX_POSITION_PCT=0.20
RISK_PER_TRADE_PCT=0.01
ATR_STOP_MULT=1.5
ATR_TP_MULT=2.5
TRAILING_STOP_ENABLED=true
TRAIL_ATR_MULT=2.0
FEE_PCT_PER_SIDE=0.0005
SLIPPAGE_PCT_PER_SIDE=0.0003

# BTC regime filter
REGIME_FILTER_ENABLED=true
REGIME_BTC_DROP_24H_PCT=-3.0
REGIME_BTC_PUMP_24H_PCT=3.0

# Symbol universe: all active Binance crypto USDT coin perpetuals.
SYMBOL_UNIVERSE=auto
TRADING_SYMBOLS_LIMIT=0

# Dynamic market categories — Mac mini worker refreshes every 30m.
MARKET_CATEGORY_K=6
CATEGORY_MIN_TRADE_VOLUME_USD=5000000
CATEGORY_MIN_TRADE_ATR_PCT=0.20
CATEGORY_MAX_TRADE_ATR_PCT=12
CATEGORY_TICK_BUCKET_SECONDS=1
CATEGORY_TTL_SECONDS=7200
CATEGORY_TRADE_ALLOWLIST=large_beta,liquid_trend,crowded_funding,volume_surge,range_meanrev

# Optional tick-bar worker defaults. Keep modest until DB size is measured.
TICKBARS_LIMIT=50
TICKBARS_BUCKET_SECONDS=1
TICKBARS_FLUSH_SECONDS=5
