# Mac Mini worker + research (Option B: shared Railway Postgres)
# Copy to .env and fill in secrets:
#   cp .env.mac.example .env

# --- Binance (Korean residential IP — required; Railway gets HTTP 451) ---
BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_api_secret
BINANCE_TESTNET=true

# --- Shared database: paste Railway Postgres DATABASE_URL here ---
# Railway → Project → Postgres plugin → Connect → DATABASE_URL
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Local paths (promotion overrides + sqlite fallback if DATABASE_URL unset)
DATA_DIR=data
DATABASE_PATH=data/trading.db

# Worker always runs the scheduler via src.worker (not the web API)
NGROK_ENABLED=false

# Optional: phone access via Cloudflare quick tunnel (see ops/cloudflare-tunnel.sh)
# Or run the dashboard locally: python -m uvicorn src.api.main:app --port 8000

# --- Trading defaults (override as needed) ---
# TRADING_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,DOT/USDT
# PAPER_STARTING_CAPITAL=10000
# COLLECTION_INTERVAL_MINUTES=5
