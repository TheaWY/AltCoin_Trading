<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.grid</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>.venv/bin/python scripts/strategy_grid.py; .venv/bin/python scripts/strategy_grid.py --cost 0.001</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <!-- daily strategy grid (taker and maker cost) after the indicator study -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/grid.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/grid.err.log</string>
</dict>
</plist>
