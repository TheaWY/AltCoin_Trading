<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.f15trend</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_PATH__/.venv/bin/python</string>
    <string>-u</string>
    <string>scripts/f15_trend_paper.py</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string><key>OMP_NUM_THREADS</key><string>4</string></dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/f15trend.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/f15trend.err.log</string>
</dict>
</plist>
