<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.pumpwatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_PATH__/.venv/bin/python</string>
    <string>scripts/pump_watch.py</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <!-- hourly: +/-10% hour events with pre-move features, model picks -->
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>2</integer></dict>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/pumpwatch.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/pumpwatch.err.log</string>
</dict>
</plist>
