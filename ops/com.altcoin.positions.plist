<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.positions</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_PATH__/.venv/bin/python</string>
    <string>-u</string>
    <string>-W</string><string>ignore</string>
    <string>scripts/position_tracker.py</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/positions.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/positions.err.log</string>
</dict>
</plist>

