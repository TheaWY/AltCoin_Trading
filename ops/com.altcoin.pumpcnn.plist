<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.pumpcnn</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_PATH__/.venv/bin/python</string>
    <string>-u</string>
    <string>-W</string><string>ignore</string>
    <string>scripts/pump_cnn_paper.py</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>2</integer></dict>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/pumpcnn.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/pumpcnn.err.log</string>
</dict>
</plist>
