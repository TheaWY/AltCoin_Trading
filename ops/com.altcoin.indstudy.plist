<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.indstudy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_PATH__/.venv/bin/python</string>
    <string>scripts/indicator_study.py</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <!-- daily precursor study over all indicators -->
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>40</integer></dict>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/indstudy.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/indstudy.err.log</string>
</dict>
</plist>
