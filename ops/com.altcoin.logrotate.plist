<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.logrotate</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__REPO_PATH__/ops/rotate_logs.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/logrotate.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/logrotate.err.log</string>
</dict>
</plist>
