<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.altcoin.logrotate</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__REPO_PATH__/ops/rotate_logs.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__REPO_PATH__/data/logs/logrotate.err.log</string>
	<key>StandardOutPath</key>
	<string>__REPO_PATH__/data/logs/logrotate.out.log</string>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>WorkingDirectory</key>
	<string>__REPO_PATH__</string>
</dict>
</plist>
