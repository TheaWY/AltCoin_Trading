<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.autoresearch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_PATH__/.venv/bin/python</string>
    <string>-u</string>
    <string>scripts/ar_engine.py</string><string>cycle</string><string>--n</string><string>12</string><string>--minutes</string><string>45</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string><key>OMP_NUM_THREADS</key><string>4</string></dict>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/autoresearch.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/autoresearch.err.log</string>
</dict>
</plist>
