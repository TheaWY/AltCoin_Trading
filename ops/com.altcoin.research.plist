<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.research</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_PATH__/ops/nightly_research.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>21600</integer>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/research.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/research.err.log</string>
</dict>
</plist>
