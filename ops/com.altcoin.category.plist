<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.category</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_PATH__/.venv/bin/python</string>
    <string>scripts/update_market_categories.py</string>
    <string>--interval-minutes</string>
    <string>30</string>
    <string>--limit</string>
    <string>0</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <key>KeepAlive</key><true/>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/category.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/category.err.log</string>
</dict>
</plist>
