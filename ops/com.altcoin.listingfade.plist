<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.altcoin.listingfade</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_PATH__/.venv/bin/python</string>
    <string>-u</string>
    <string>scripts/upbit_listing_fade_paper.py</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>5</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__REPO_PATH__/data/logs/listingfade.out.log</string>
  <key>StandardErrorPath</key><string>__REPO_PATH__/data/logs/listingfade.err.log</string>
</dict>
</plist>
