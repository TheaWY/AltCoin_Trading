# Binance Testnet credentials (https://testnet.binancefuture.com)
BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_api_secret
BINANCE_TESTNET=true

# Optional overrides
# DATABASE_PATH=data/trading.db
# API_HOST=0.0.0.0
# API_PORT=8000

# Ngrok — public phone access (uses installed ngrok CLI + ~/.ngrok/ngrok.yml)
# NGROK_ENABLED=true
# NGROK_USE_CLI=true
# NGROK_AUTHTOKEN=   # optional override
# NGROK_REGION=us
