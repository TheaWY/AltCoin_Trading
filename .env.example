# Binance Testnet credentials (https://testnet.binancefuture.com)
BINANCE_API_KEY=your_testnet_api_key
BINANCE_API_SECRET=your_testnet_api_secret
BINANCE_TESTNET=true

# Optional overrides
# DATABASE_PATH=data/trading.db
# API_HOST=0.0.0.0
# API_PORT=8000  # leave unset on Railway; Railway provides PORT automatically

# Postgres (recommended on Railway — add the Postgres plugin and it injects this).
# When set, storage uses Postgres; when unset, SQLite at DATABASE_PATH is used.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Cloud 24/7 deploy (Railway / Fly.io) — see scripts/deploy-cloud.sh ---
# DEPLOYMENT_MODE=cloud
# DATA_DIR=/data
# DATABASE_PATH=/data/trading.db
# NGROK_ENABLED=false
# RUN_TRADING_SCHEDULER=true  # default; set false on the web service only when a dedicated worker service runs
# PUBLIC_URL=https://your-app.up.railway.app

# --- Research paper-only mode: 1,000,000 KRW / about 730 USDT ---
# LIVE_TRADING=false
# PAPER_STARTING_CAPITAL=730
# MIN_ORDER_NOTIONAL_USDT=5
# MIN_EXPECTED_NET_USD=0.25

# Strategies: first entry is the primary one that drives trades; the rest
# also record signals so their accuracy can be compared.
# Research stack, paper-only:
# ACTIVE_STRATEGIES=funding_carry,positioning_short,grid,mean_reversion,donchian_breakout,tsmom_28d,pair_trading,listing_reversion,funding_rate,momentum,volume_spike
# Conservative default:
# ACTIVE_STRATEGIES=funding_carry,positioning_short,grid

# Direction policy — LONG entries are disabled by default (short/swing-short only).
# ALLOW_LONG=false
# ALLOW_SHORT=true

# Risk management (ATR-based exits + volatility-inverse sizing)
# ATR_STOP_MULT=1.5          # stop = 1.5 x 1h ATR
# ATR_TP_MULT=2.5            # target = 2.5 x 1h ATR
# RISK_PER_TRADE_PCT=0.01    # risk 1% of portfolio per trade
# SCALP_MAX_HOLD_HOURS=48    # time stop for scalps
# SWING_MAX_HOLD_HOURS=720   # swing = max 1 month; longer would be a long-term hold
# TRAILING_STOP_ENABLED=true
# TRAIL_ATR_MULT=2.0
# FEE_PCT_PER_SIDE=0.0005    # Binance futures taker
# SLIPPAGE_PCT_PER_SIDE=0.0003

# Delta-neutral funding carry thresholds
# CARRY_ENTRY_RATE=0.0001
# CARRY_ENTRY_CONSECUTIVE=6
# CARRY_EXIT_RATE=0.00005
# CARRY_EXIT_CONSECUTIVE=3
# CARRY_MIN_HOLD_SETTLEMENTS=21
# CARRY_FEE_ROUNDTRIP=0.003

# Crowding / positioning short thresholds
# POS_SHORT_RATIO_ABS=2.5
# POS_SHORT_FUNDING_MIN=0.0003
# POS_SHORT_OI_PROXIMITY=0.05
# POS_SHORT_MIN_HISTORY_DAYS=90

# Paper-only grid strategy
# GRID_RANGE_HOURS=168
# GRID_LEVELS=10
# GRID_MAX_TREND_PCT=8
# GRID_SHORT_ZONE=0.70

# Pair-trading sandbox
# PAIR_TRADING_BENCHMARK=BTC/USDT
# PAIR_TRADING_ALT_BENCHMARK=ETH/USDT
# PAIR_Z_ENTRY=2.0

# Listing-event sandbox
# LISTING_MAX_AGE_HOURS=72
# LISTING_DUMP_TRIGGER_PCT=-12
# LISTING_PUMP_TRIGGER_PCT=20

# BTC regime filter — blocks new entries against a strong BTC move
# REGIME_FILTER_ENABLED=true
# REGIME_BTC_DROP_24H_PCT=-3.0
# REGIME_BTC_PUMP_24H_PCT=3.0

# Confidence calibration — blend setup scores with realized win rates
# CALIBRATION_PRIOR_WEIGHT=20
# CALIBRATION_MIN_TRADES=5

# Symbol universe: auto (default) = every active Binance USDT perpetual,
# ranked by 24h volume. static = only TRADING_SYMBOLS below.
# SYMBOL_UNIVERSE=auto
# TRADING_SYMBOLS_LIMIT=0   # 0 = all; e.g. 100 = top 100 by volume
# TRADING_SYMBOLS=BTC/USDT,ETH/USDT,...   # core list (full timeframes) + fallback

# Ngrok — local Mac phone access only (not needed on cloud; uses installed ngrok CLI + its configured authtoken)
# NGROK_ENABLED=true
# NGROK_USE_CLI=true
# NGROK_WEB_PORT=4042
# NGROK_STATIC_DOMAIN=your-name.ngrok-free.app   # permanent URL — see scripts/setup-ngrok-domain.sh
