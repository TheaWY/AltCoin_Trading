# Binance credentials
# For paper trading, live orders stay disabled but market data should come from
# real public Binance futures endpoints so the alt universe has real candles.
# Leave keys blank for paper/data collection. Add real keys only for explicit live-order testing.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_MARKET_DATA_TESTNET=false

# Optional overrides
# DATABASE_PATH=data/trading.db
# API_HOST=0.0.0.0
# API_PORT=8000  # leave unset on Railway; Railway provides PORT automatically

# Postgres (recommended on Railway — add the Postgres plugin and it injects this).
# When set, storage uses Postgres; when unset, SQLite at DATABASE_PATH is used.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Cloud 24/7 deploy (Railway / Fly.io) — see docs/DEPLOYMENT.md ---
# DEPLOYMENT_MODE=cloud
# DATA_DIR=/data
# DATABASE_PATH=/data/trading.db
# NGROK_ENABLED=false
# RUN_TRADING_SCHEDULER=false  # default on cloud — Binance returns 451 from US IPs
# DATABASE_URL=postgresql://...  # Railway Postgres; Mac worker writes here too (Option B)
# PUBLIC_URL=https://your-app.up.railway.app

# --- Conservative research mode: paper first, low turnover, no unproven live execution ---
LIVE_TRADING=false
RUN_TRADING_SCHEDULER=true
# Internal paper notional is USDT. ₩1,000,000 at 1,400 KRW/USDT ≈ 714.285714 USDT.
# Keep this value the same on Railway and the Mac worker.
PAPER_STARTING_CAPITAL=714.285714
ENTRY_DECISION_ENGINE=evaluation
MIN_CONFIDENCE=0.70
COOLDOWN_HOURS_PER_SYMBOL=48
SETUP_BREAKOUT_ENABLED=false
SETUP_TSMOM_ENABLED=false
SETUP_VOLUME_ENABLED=false
FEE_MODE=taker

# Strategies: first entry is the primary one that drives legacy signal entries;
# the rest also record signals so their accuracy can be compared.
# ACTIVE_STRATEGIES=funding_rate,momentum,volume_spike

# Direction policy — LONG entries are disabled by default (short/swing-short only).
ALLOW_LONG=false
ALLOW_SHORT=true

# Risk management (ATR-based exits + volatility-inverse sizing)
# ATR_STOP_MULT=1.5          # stop = 1.5 x 1h ATR
# ATR_TP_MULT=2.5            # target = 2.5 x 1h ATR
# RISK_PER_TRADE_PCT=0.01    # risk 1% of portfolio per trade
# SCALP_MAX_HOLD_HOURS=48    # time stop for scalps
# SWING_MAX_HOLD_HOURS=720   # swing = max 1 month; longer would be a long-term hold
# TRAILING_STOP_ENABLED=true
# TRAIL_ATR_MULT=2.0
# FEE_PCT_PER_SIDE=0.0005    # Binance futures taker
# SLIPPAGE_PCT_PER_SIDE=0.0003

# BTC regime filter — blocks new entries against a strong BTC move
# REGIME_FILTER_ENABLED=true
# REGIME_BTC_DROP_24H_PCT=-3.0
# REGIME_BTC_PUMP_24H_PCT=3.0

# Confidence calibration — blend setup scores with realized win rates
# CALIBRATION_PRIOR_WEIGHT=20
# CALIBRATION_MIN_TRADES=5

# Dynamic market categories — run scripts/update_market_categories.py on Mac mini.
# Category snapshots are refreshed every 30m and used as an extra paper-entry filter.
MARKET_CATEGORY_K=6
CATEGORY_MIN_TRADE_VOLUME_USD=5000000
CATEGORY_MIN_TRADE_ATR_PCT=0.20
CATEGORY_MAX_TRADE_ATR_PCT=12
CATEGORY_TICK_BUCKET_SECONDS=1
CATEGORY_TTL_SECONDS=7200
CATEGORY_TRADE_ALLOWLIST=large_beta,liquid_trend,crowded_funding,volume_surge,range_meanrev

# Symbol universe: auto (default) = active Binance crypto USDT coin perpetuals,
# ranked by 24h volume. static = only TRADING_SYMBOLS below.
SYMBOL_UNIVERSE=auto
TRADING_SYMBOLS_LIMIT=100   # start with top 100 so collection is faster/stabler
# TRADING_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT,ADA/USDT,AVAX/USDT,LINK/USDT,DOT/USDT

# Ngrok — local Mac phone access only (not needed on cloud; uses installed ngrok CLI + its configured authtoken)
# NGROK_ENABLED=true
# NGROK_USE_CLI=true
# NGROK_WEB_PORT=4042
# NGROK_STATIC_DOMAIN=your-name.ngrok-free.app   # permanent URL — see scripts/setup-ngrok-domain.sh
